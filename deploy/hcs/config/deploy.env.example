# Copy to /etc/hydro-hcs/deploy.env, fill every value, then chmod 0640 root:hydro-hcs.
# Image references are rejected by verification unless they contain @sha256:.
HCS_IMAGE=
HCS_POSTGRES_IMAGE=
HCS_AGE_IMAGE=
HCS_ACL_PROBE_IMAGE=
HCS_CONFIG_DIR=/etc/hydro-hcs
HCS_BIND_ADDRESS=
HCS_HTTPS_PORT=443
HCS_POSTGRES_DB=hydro_hcs
HCS_POSTGRES_USER=hydro_hcs
HCS_RESTORE_POSTGRES_DB=hydro_hcs_restore
HCS_BACKUP_DIR=/var/backups/hydro-hcs
HCS_BACKUP_RECIPIENT_FILE=/etc/hydro-hcs/backup-age-recipient
HCS_BACKUP_RETENTION_SECONDS=
HCS_TABLE_RETENTION_SECONDS=
HCS_ABSOLUTE_RETENTION_SECONDS=
HCS_STORAGE_ENCRYPTION_EVIDENCE_FILE=
HCS_MODEL_ACL_TEST_URL=
HCS_RESTORE_DATABASE_URL=
