{
	"name": "@hydrozagent/control-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Hydro Control Server for managed hydroZagent deployments",
	"bin": {
		"hydro-hcs": "dist/admin-cli/cli.js"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"admin": "node dist/admin-cli/cli.js admin",
		"check": "npm run typecheck && npm run build",
		"contracts:check": "node ../../scripts/check-hcs-contracts.mjs",
		"migrate": "node dist/db/cli.js",
		"start": "node dist/index.js",
		"test": "vitest run --exclude test/integration/**",
		"test:integration": "vitest run test/integration",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"fastify": "5.12.1",
		"hash-wasm": "4.12.0",
		"jose": "6.2.10",
		"pg": "8.23.0",
		"typebox": "1.3.24"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"@types/pg": "8.23.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
